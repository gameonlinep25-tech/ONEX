);direction:ltr;text-align:left;outline:none;padding-inline:4px 16px;min-width:0}\n.ctl input::placeholder{color:var(--dim);font-family:Vazirmatn;font-weight:400;direction:rtl}\n.eye{flex:none;width:44px;height:44px;margin-inline-end:5px;border:0;background:transparent;color:var(--dim);cursor:pointer;border-radius:10px;display:grid;place-items:center}\n.eye:hover{color:var(--tx);background:var(--s1)}\n.eye:focus-visible{outline:2px solid var(--primary);outline-offset:1px}\n.eye svg{width:18px;height:18px}\n.field.bad .ctl{border-color:oklch(72% 0.16 25)}\n.row{display:flex;justify-content:space-between;align-items:center;font-size:12.5px;color:var(--mut);margin-top:2px}\n.chk{display:flex;align-items:center;gap:9px;cursor:pointer;user-select:none}\n.chk input{appearance:none;width:18px;height:18px;border-radius:5px;border:1px solid var(--line-2);background:var(--s2);display:grid;place-items:center;cursor:pointer;transition:.2s}\n.chk input:checked{background:var(--primary);border-color:var(--primary)}\n.chk input:checked::after{content:\"\";width:9px;height:5px;border-left:2px solid var(--primary-dark);border-bottom:2px solid var(--primary-dark);transform:rotate(-45deg) translate(1px,-1px)}\n.chk input:focus-visible{outline:2px solid var(--primary);outline-offset:2px}\n.lock{font-family:var(--mono);font-size:11px;color:var(--dim);direction:ltr;display:flex;align-items:center;gap:6px}\n.lock svg{width:13px;height:13px}\n.btn{position:relative;height:56px;border:0;border-radius:14px;background:var(--primary);color:var(--primary-dark);font:800 15.5px Vazirmatn;cursor:pointer;\n  display:flex;align-items:center;justify-content:space-between;padding:0 22px;margin-top:6px;overflow:hidden;\n  transition:transform .25s var(--ease-q),background-color .2s;transform-style:preserve-3d}\n.btn:hover{background:var(--primary-2);transform:translateZ(22px) translateY(-1px)}\n.btn:active{transform:translateZ(6px) scale(.985)}\n.btn:focus-visible{outline:2px solid var(--tx);outline-offset:3px}\n.btn .arr{width:34px;height:34px;border-radius:10px;background:var(--primary-dark);color:var(--primary);display:grid;place-items:center;transition:transform .35s var(--ease)}\n.btn:hover .arr{transform:translateX(-4px)}\n.btn::after{content:\"\";position:absolute;inset:0;background:linear-gradient(100deg,transparent 35%,oklch(100% 0 0 / .35) 50%,transparent 65%);transform:translateX(120%);transition:none}\n.btn:hover::after{transform:translateX(-120%);transition:transform .9s var(--ease)}\n.msg{display:grid;grid-template-rows:0fr;transition:grid-template-rows .35s var(--ease)}\n.msg>div{overflow:hidden}\n.msg.show{grid-template-rows:1fr}\n.msg p{font-size:13px;line-height:1.8;padding:11px 14px;border-radius:12px;background:oklch(26% 0.05 25);color:oklch(72% 0.16 25);border:1px solid oklch(40% 0.08 25)}\n.hint{margin-top:22px;padding-top:18px;border-top:1px dashed var(--line);font-size:12px;color:var(--dim);line-height:1.9}\n.hint code{font-family:var(--mono);color:var(--mut);background:var(--s2);padding:1px 7px;border-radius:6px;direction:ltr;display:inline-block}\n.chip{display:inline-flex;align-items:center;gap:8px;background:var(--secondary);color:var(--secondary-dark);font-size:12px;font-weight:700;padding:5px 12px 5px 14px;border-radius:99px}\n.chip svg{width:14px;height:14px}\n.meter{display:flex;gap:6px;margin-top:10px;direction:ltr}\n.meter i{flex:1;height:4px;border-radius:4px;background:var(--s3);transition:background-color .3s}\n.meter[data-s=\"1\"] i:nth-child(-n+1){background:oklch(72% 0.16 25)}\n.meter[data-s=\"2\"] i:nth-child(-n+2){background:var(--secondary)}\n.meter[data-s=\"3\"] i:nth-child(-n+3){background:var(--primary-2)}\n.meter[data-s=\"4\"] i{background:var(--primary)}\n.mlabel{font-size:11.5px;color:var(--dim);margin-top:6px;min-height:1em}\n.ghost{background:none;border:0;color:var(--mut);font:500 13px Vazirmatn;cursor:pointer;margin-top:4px;align-self:center;padding:8px 12px;border-radius:8px}\n.ghost:hover{color:var(--tx);background:var(--s2)}\n.ghost:focus-visible{outline:2px solid var(--primary)}\n.btn.a{background:var(--secondary);color:var(--secondary-dark)}\n.btn.a:hover{background:oklch(86% 0.14 70)}\n.btn.a .arr{background:var(--secondary-dark);color:var(--secondary)}\n.done{position:absolute;inset:0;background:var(--s1);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;opacity:0;pointer-events:none;transition:opacity .5s var(--ease);border-radius:inherit}\n.done.show{opacity:1;pointer-events:auto}\n.done svg{width:74px;height:74px}\n.done circle{stroke-dasharray:220;stroke-dashoffset:220}\n.done path{stroke-dasharray:60;stroke-dashoffset:60}\n.done.show circle{animation:draw 1s var(--ease) forwards}\n.done.show path{animation:draw .6s var(--ease) .45s forwards}\n@keyframes draw{to{stroke-dashoffset:0}}\n.done b{font-size:22px;font-weight:800}\n.done span{font-size:13px;color:var(--mut)}\n@media (max-width:980px){\n  .hero{display:none}\n  .stage{width:100%;left:0}\n  .chan span:nth-child(n+2){display:none}\n  .bar,.foot{padding:0 20px}\n}\n@media (max-width:520px){\n  .face{padding:32px 22px 24px;border-radius:18px}\n  .face h1{font-size:25px}\n  .foot span:first-child{display:none}\n  .foot{justify-content:center}\n  .brand small{display:none}\n}\n@media (prefers-reduced-motion:reduce){\n  *,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}\n}\n</style>\n</head>\n<body>\n<canvas id=\"globe\" aria-hidden=\"true\"></canvas>\n<div class=\"vignette\"></div>\n\n<header class=\"bar\">\n  <div class=\"brand\">\n    <svg viewBox=\"0 0 32 32\" fill=\"none\"><rect x=\"1\" y=\"1\" width=\"30\" height=\"30\" rx=\"9\" fill=\"oklch(90% 0.19 124)\"/><circle cx=\"16\" cy=\"16\" r=\"7\" stroke=\"oklch(21% 0.05 124)\" stroke-width=\"3\"/><path d=\"M9 23 23 9\" stroke=\"oklch(21% 0.05 124)\" stroke-width=\"3\" stroke-linecap=\"round\"/></svg>\n    ONEX <small>1.3.8</small>\n  </div>\n  <div class=\"chan\">\n    <span><i c