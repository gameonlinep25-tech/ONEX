+LOGIN_HTML = "<!DOCTYPE html>\n<html lang=\"fa\" dir=\"rtl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>ONEX \u00b7 \u0648\u0631\u0648\u062f</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;700;800&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n<style>\n:root{\n  --primary:oklch(90% 0.19 124);\n  --primary-2:oklch(82% 0.18 126);\n  --primary-dark:oklch(21% 0.05 124);\n  --secondary:oklch(90% 0.15 70);\n  --secondary-dark:oklch(22% 0.06 70);\n  --bg:oklch(14.5% 0.012 125);\n  --s1:oklch(19% 0.014 125);\n  --s2:oklch(23.5% 0.016 125);\n  --s3:oklch(28% 0.018 125);\n  --line:oklch(31% 0.018 125);\n  --line-2:oklch(38% 0.02 125);\n  --tx:oklch(95% 0.01 120);\n  --mut:oklch(70% 0.02 120);\n  --dim:oklch(54% 0.018 120);\n  --ease:cubic-bezier(0.16,1,0.3,1);\n  --ease-q:cubic-bezier(0.25,1,0.5,1);\n  --mono:\"JetBrains Mono\",ui-monospace,monospace;\n}\n*{box-sizing:border-box;margin:0;padding:0}\nhtml,body{height:100%}\nbody{\n  font-family:Vazirmatn,system-ui,sans-serif;background:var(--bg);color:var(--tx);\n  overflow:hidden;-webkit-font-smoothing:antialiased;letter-spacing:.005em;\n}\ncanvas#globe{position:fixed;inset:0;display:block}\n.vignette{position:fixed;inset:0;pointer-events:none;\n  background:radial-gradient(120% 90% at 30% 50%,transparent 45%,oklch(11% 0.01 125) 100%)}\n.bar{position:fixed;inset-inline:0;top:0;height:56px;display:flex;align-items:center;justify-content:space-between;\n  padding:0 40px;border-bottom:1px solid var(--line);font-family:var(--mono);font-size:12px;color:var(--mut);z-index:5;\n  background:oklch(14.5% 0.012 125 / .72)}\n.brand{display:flex;align-items:center;gap:12px;color:var(--tx);font-weight:500;letter-spacing:.08em}\n.brand svg{width:26px;height:26px}\n.brand small{color:var(--dim);letter-spacing:0}\n.chan{display:flex;gap:22px;direction:ltr}\n.chan span{display:flex;align-items:center;gap:8px}\n.dot{width:7px;height:7px;border-radius:50%;background:var(--primary);position:relative}\n.dot::after{content:\"\";position:absolute;inset:-4px;border-radius:50%;border:1px solid var(--primary);opacity:0;animation:ping 2.4s var(--ease) infinite}\n.chan span:nth-child(2) .dot::after{animation-delay:.8s}\n.chan span:nth-child(3) .dot::after{animation-delay:1.6s}\n@keyframes ping{0%{transform:scale(.6);opacity:.9}100%{transform:scale(2.2);opacity:0}}\n.foot{position:fixed;inset-inline:0;bottom:0;height:52px;display:flex;align-items:center;justify-content:space-between;\n  padding:0 40px;border-top:1px solid var(--line);font-size:12px;color:var(--dim);z-index:5}\n.foot a{color:var(--mut);text-decoration:none;font-family:var(--mono);direction:ltr}\n.foot a:hover{color:var(--primary)}\n.hero{position:fixed;left:6vw;bottom:96px;z-index:3;direction:rtl;text-align:right;width:min(460px,34vw);pointer-events:none}\n.hero .k{font-family:var(--mono);font-size:12px;color:var(--primary);direction:ltr;text-align:right;margin-bottom:16px;letter-spacing:.04em}\n.hero h2{font-size:clamp(34px,3.4vw,52px);line-height:1.2;font-weight:800;letter-spacing:-.01em;text-wrap:balance}\n.hero p{margin-top:16px;font-size:15px;line-height:1.95;color:var(--mut);max-width:40ch}\n.hero,.stage{opacity:0}\n.ready .hero{animation:rise 1.1s var(--ease) .35s forwards}\n.stage{position:fixed;top:56px;bottom:52px;right:0;width:min(560px,44vw);display:grid;place-items:center;z-index:4;perspective:1400px}\n.ready .stage{animation:stageIn 1.2s var(--ease) .15s forwards}\n@keyframes stageIn{from{opacity:0;transform:translateY(40px)}to{opacity:1;transform:none}}\n@keyframes rise{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:none}}\n.tilt{width:min(440px,100% - 48px);transform-style:preserve-3d;transition:transform .5s var(--ease-q);will-change:transform}\n.flip{display:grid;transform-style:preserve-3d;transition:transform 1s